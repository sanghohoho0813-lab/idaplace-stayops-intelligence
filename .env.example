# StayOps Intelligence — 환경변수 예시 (실제 값은 .env.local 에만 넣고 Git에 올리지 마세요)

# [도어락] 실제 스마트 도어락 연동 스위치. 공식 API 계약·실기기 검증 전까지 반드시 false.
# true로 바꿔도 LiveAccessProvider는 미구현 상태라 모든 요청이 차단됩니다.
LIVE_LOCK_ENABLED=false

# [도어락-데모] Demo 출입코드 생성용 서버 비밀값 (선택). 미설정 시 개발용 기본값 사용.
DEMO_ACCESS_SECRET=change-me-demo-only

# [향후] Supabase 연동 시 (현재 미연결 — DemoRepository 사용 중)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # 서버 전용, 절대 NEXT_PUBLIC_ 접두사 금지

# [향후] AI 운영 코치 자연어 요약 (현재 미연결 — 규칙 기반 진단 · AI Ready)
# ANTHROPIC_API_KEY=           # 서버 전용
